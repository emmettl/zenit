{
  "name": "zenit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZENIT — an Earth-orbit Motion Studies edition",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.21.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/copy-licences.mjs && node scripts/check-publication.mjs",
    "check": "npm run test && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@motionstudies/core": "0.1.0-alpha.31",
    "@motionstudies/web": "0.1.0-alpha.31",
    "astronomy-engine": "2.1.19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
