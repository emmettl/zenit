{
  "name": "zenit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZENIT — an Earth-orbit Motion Studies edition",
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "npm@12.2.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/copy-licences.mjs && node scripts/check-publication.mjs",
    "check": "npm run test && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "proof:debris": "node scripts/compile-debris-proof.mjs && vite build --config research/debris/vite.config.mjs",
    "proof:debris:preview": "vite preview --config research/debris/vite.config.mjs --port 4196 --strictPort",
    "check:stack": "node scripts/check-stack.mjs"
  },
  "dependencies": {
    "@motionstudies/core": "1.0.0",
    "@motionstudies/web": "1.0.0",
    "astronomy-engine": "2.1.19",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "satellite.js": "7.1.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
    "@motionstudies/tooling": "1.0.0"
  }
}
